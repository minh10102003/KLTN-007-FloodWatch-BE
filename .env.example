# Sao chép thành file .env và điền giá trị thật (không commit .env)

# --- Neon PostgreSQL (Render / local) ---
# Copy connection string từ Neon Console (có ?sslmode=require). Khi set, app dùng DATABASE_URL thay DB_*.
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Sau khi tạo DB trống: npm run db:neon-postgis
# DB local (chỉ khi không dùng DATABASE_URL):
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=hcm_flood_db
# DB_PASS=
# DB_PORT=5432

# MQTT / JWT ... (theo môi trường của bạn)

# --- Google OAuth (đăng nhập / đăng ký qua Google) ---
# Tạo OAuth Client (Web) trong Google Cloud Console; Authorized redirect URI phải khớp từng ký tự:
#   https://api.floodsight.id.vn/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.floodsight.id.vn/api/v1/auth/google/callback
# FE nhận token trong URL hash sau khi redirect (xem docs hoặc googleAuthController).
# GOOGLE_OAUTH_SUCCESS_REDIRECT=https://floodsight.id.vn/login
# GOOGLE_OAUTH_ERROR_REDIRECT=https://floodsight.id.vn/login
# App native (Capacitor): đăng nhập Google / deep link — cấu hình sau khi cần (Google Console + redirect về app).
# Tuỳ chọn: secret ký state (mặc định dùng JWT_SECRET)
# GOOGLE_OAUTH_STATE_SECRET=

# --- JWT (access + refresh session) ---
# Bắt buộc production (Render). Không commit giá trị thật — chỉ .env local + Render env.
# JWT_SECRET=your-long-random-secret-at-least-32-chars
# Access token: dùng cho Authorization Bearer; mặc định 30 phút — hết hạn thì FE gọi POST /api/auth/refresh hoặc logout.
# JWT_ACCESS_EXPIRES_IN=30m
# Phiên refresh (session_token + refresh_token): sau thời điểm này user phải đăng nhập lại.
# JWT_REFRESH_EXPIRES_DAYS=7

# --- Resend: gửi OTP email ---
# Tạo key tại https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Phải là địa chỉ thuộc domain đã Verified trên Resend
OTP_FROM_EMAIL=OTP FloodSight <no-reply@floodsight.id.vn>
# ID hoặc alias template OTP đã Publish. HTML mẫu (copy vào Resend): templates/resend-otp.html
RESEND_OTP_TEMPLATE_ID=email-change-otp
# Tuỳ chọn: tên thương hiệu trong mail (mặc định FloodWatch)
# OTP_BRAND_NAME=FloodSight
# Email hỗ trợ hiển thị trong mail (mặc định lấy từ OTP_FROM_EMAIL)
# OTP_SUPPORT_EMAIL=hotline@floodsight.id.vn
# Link "trang chủ" trong mail (mặc định # hoặc PUBLIC_WEB_URL nếu có)
# OTP_HELP_URL=https://floodsight.id.vn

OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- CORS ---
# Danh sách origin được phép, cách nhau bằng dấu phẩy (ngoài default localhost + domain production đã hardcode).
# Mặc định trong code đã gồm localhost:5173 (FE user), :5174 (admin Vite), :3000,
# và production floodsight / floodlight + https://admin.floodsight.id.vn (FE admin).
# Native Android (Capacitor): code đã whitelist https://localhost, http://localhost, capacitor://localhost, ionic://localhost.
# Nếu APK vẫn bị chặn CORS, bật log để đọc Origin chính xác rồi thêm vào biến dưới:
# CORS_LOG_BLOCKED_ORIGINS=true
# Thêm origin khác (staging / custom WebView): CORS_ALLOWED_ORIGINS=http://localhost:5175,...
# Ví dụ: CORS_ALLOWED_ORIGINS=https://staging.floodsight.id.vn,https://admin.floodsight.id.vn
# CORS_ALLOWED_ORIGINS=

# --- Google Geocoding API (reverse geocode lat/lng -> địa chỉ tiếng Việt có dấu) ---
# Dùng cho script scripts/updateSensorLocations.js
# GOOGLE_GEOCODING_API_KEY=AIza... (không commit key thật)

# --- Google Places + Geocoding (gợi ý địa chỉ / chi tiết place — BE cho FE) ---
# GET /api/v1/geocode/search | /place | /forward (public, có rate limit).
# Bật APIs trên Google Cloud: Places API (Autocomplete + Place Details) và Geocoding API.
# Có thể dùng cùng một key cho cả ba nếu project đã bật đủ quyền:
# GOOGLE_PLACES_API_KEY=   # tuỳ chọn; nếu trống sẽ dùng GOOGLE_GEOCODING_API_KEY
# GEOCODE_SEARCH_MAX_PER_MINUTE=60

# --- Ảnh báo cáo (/uploads) & reverse proxy ---
# Origin công khai (không slash cuối). API ghép photo_url full URL từ giá trị này thay vì Host của request.
# Dùng khi ảnh phục vụ cùng domain public (vd https://api.floodsight.id.vn)
# Railway + app mobile (Capacitor): đặt URL mà điện thoại load được ảnh (HTTPS), nên trùng host API public
# (tránh photo_url trỏ LAN/private mà máy thật không mở được).
# PUBLIC_BASE_URL=https://api.floodsight.id.vn
# Tương đương: UPLOADS_PUBLIC_ORIGIN=
# Tin cậy X-Forwarded-* (Railway/nginx). Tắt: TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Railway: filesystem container là tạm — mount Volume vào thư mục uploads của app (thường /app/uploads)
# để ảnh không mất sau deploy/restart. Nếu không volume: URL trong DB vẫn còn nhưng file 404.

# --- Fusion cảm biến + crowd (GET /api/v1/fusion/points) ---
# Bán kính tối đa (m) để còn trộn với cảm biến gần nhất; xa hơn chỉ dùng crowd.
# FUSION_R_MAX_M=2500
# Giảm trọng số cảm biến theo khoảng cách: exp(-dist / FUSION_DECAY_DIST_M)
# FUSION_DECAY_DIST_M=600
# Giảm trọng số crowd khi |crowd_cm - sensor_cm| lớn: exp(-|diff| / scale)
# FUSION_DISAGREE_SCALE_CM=18

# --- Thời tiết Open-Meteo (GET /api/v1/weather/hcm) — https://open-meteo.com/ ---
# Mặc định: trung tâm TP.HCM 10°49′23″N, 106°37′46″E (Cổng TT TP.HCM) ≈ 10.823056, 106.629444
# WEATHER_HCM_LAT=10.823056
# WEATHER_HCM_LON=106.629444
# Cache phản hồi (giây), tối thiểu 60 — tăng (vd. 3600) nếu gặp Open-Meteo HTTP 429
# WEATHER_CACHE_SECONDS=7200
# Sau HTTP 429: không gọi Open-Meteo trong N giây (mặc định 600), trả cache/fallback
# WEATHER_COOLDOWN_SECONDS=600
# Gọi Open-Meteo 1 lần/coord với N ngày (mặc định 3) — FE gọi forecast_days=1 và =3 vẫn dùng chung cache
# WEATHER_FETCH_DAYS=3
# WEATHER_RETRY_ATTEMPTS=4
# API key (tuỳ chọn): https://open-meteo.com/en/pricing — base URL customer-api
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
# OPEN_METEO_API_KEY=
# Khi Open-Meteo lỗi/429: vẫn trả cache cũ trong tối đa N giây (mặc định 86400 = 24h)
# WEATHER_STALE_MAX_SECONDS=86400

# --- Tin RSS TP.HCM (GET /api/news, GET /api/v1/news/hcm) ---
# NEWS_CACHE_SECONDS=900
# NEWS_STALE_MAX_SECONDS=86400
# NEWS_HTTP_CACHE_SECONDS=900
# NEWS_API_MAX_PER_MINUTE=120
# NEWS_RSS_TIMEOUT_MS=15000

# --- Vị trí user (GPS) ---
# DB: chạy `npm run migrate:user-last-location`. FE: Geolocation → POST /api/auth/location { lat, lng, accuracy_m? }

# --- Nhóm B: idempotency MQTT (flood_logs.ingest_key) ---
# DB: chạy `npm run migrate:flood-ingest-key` trước khi deploy code mới.

# --- Nhóm B: Device health (GET /api/v1/admin/devices/health, admin JWT) ---
# Khoảng phút từ lần đo cuối → coi là "online" (mặc định 2)
# HEALTH_ONLINE_MAX_MINUTES=2
# Tới ngưỡng này → "degraded" (mặc định 5; lớn hơn là offline)
# HEALTH_DEGRADED_MAX_MINUTES=5

# --- Nhóm B: Rate limit POST báo cáo lũ công khai (/api/report-flood) ---
# Cửa sổ (ms), mặc định 900000 (15 phút)
# REPORT_FLOOD_WINDOW_MS=900000
# Số request tối đa mỗi IP trong cửa sổ (mặc định 30)
# REPORT_FLOOD_MAX_PER_WINDOW=30

# --- Nhóm C1: thông báo đa kênh khi cảnh báo ---
# Webhook generic (tuỳ chọn): backend sẽ POST JSON cảnh báo tới URL này
# EMERGENCY_WEBHOOK_URL=https://your-webhook-endpoint.example.com/flood-alert
# Bearer token cho webhook (tuỳ chọn)
# EMERGENCY_WEBHOOK_BEARER=
# Telegram Bot (tuỳ chọn)
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# Chat chung (demo / nhóm): nếu user chưa liên kết chat riêng, cảnh báo vẫn gửi vào đây
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# Username bot (không @) — bắt buộc cho deep link POST /api/auth/telegram/link
# TELEGRAM_BOT_USERNAME=YourFloodWatchBot
# Webhook: URL HTTPS công khai + secret (setWebhook secret_token).
# Chỉ được ký tự A–Z, a–z, 0–9, _ và - (không dùng base64 có dấu =). Ví dụ: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=your_hex_or_alphanumeric_secret
# TTL token /start (phút), mặc định 15
# TELEGRAM_LINK_TTL_MINUTES=15
# DB: npm run migrate:telegram-per-user
#
# Dedupe + retry (Nhóm C1 hoàn thiện)
# DB: chạy `npm run migrate:emergency-alert-send-log` (Railway: railway ssh "npm run migrate:emergency-alert-send-log")
# Không gửi lại cùng sensor + user + loại cảnh báo trong N phút sau khi đã gửi thành công
# EMERGENCY_ALERT_COOLDOWN_MINUTES=20
# Số lần thử lại mỗi kênh (email/webhook/telegram) khi lỗi mạng tạm thời
# EMERGENCY_NOTIFY_MAX_RETRIES=3
# Khoảng chờ cơ sở (ms), backoff tuyến tính: base * (1 + 2 + ...)
# EMERGENCY_NOTIFY_RETRY_BASE_MS=400

# --- Routing AMC-A* (MVP) ---
# DB: chạy `npm run migrate:road-graph` để tạo road_nodes/road_edges
# Khoảng cách tối đa (m) để map điểm start/end vào node gần nhất
# ROUTING_NEAREST_NODE_MAX_M=1200
# Phương án 1: chỉ gán flood_sensor_id cho cạnh có centroid trong phạm vi này tới sensor active gần nhất (npm run map:road-sensors).
# Nên cùng bậc với ROUTING_SENSOR_FLOOD_RADIUS_M (vd R=120 → 150m) hoặc nhỏ hơn nếu muốn rất chặt. Tránh 2500m trừ khi bạn cố ý gom rộng.
# ROUTING_EDGE_SENSOR_MAX_DISTANCE_M=150
# Bán kính (m) quanh tọa độ sensor: mực nước từ flood_logs chỉ áp vào edge nằm trong khoảng cách này (ST_Distance geom–sensor).
# Ngoài bán kính: coi sensor_depth = 0 (trừ crowd/manual). Giảm “nhuộm đỏ” cả tuyến khi nhiều edge gắn chung một sensor.
# ROUTING_SENSOR_FLOOD_RADIUS_M=120
# plateau = đủ mực nước log trong bán kính; linear = suy giảm tuyến tính theo khoảng cách (0 tại r=R)
# ROUTING_SENSOR_FLOOD_DECAY=linear
# Dùng crowd report đã duyệt trong N giờ gần nhất để tăng phạt ngập trên edge gần report
# ROUTING_CROWD_REPORT_HOURS=6
# Khoảng cách (m) từ edge tới crowd report để coi là ảnh hưởng
# ROUTING_CROWD_EDGE_BUFFER_M=35
# Half-life (giờ) cho ảnh hưởng crowd report theo thời gian (report mới -> tác động mạnh hơn)
# ROUTING_CROWD_RECENCY_HALF_LIFE_HOURS=2
# Chỉ dùng report có reliability_score >= ngưỡng này
# ROUTING_CROWD_MIN_RELIABILITY=40
# Hệ số tăng tối đa cho độ sâu ngập từ crowd report sau khi tính decay/reliability
# ROUTING_CROWD_MAX_BOOST=1.5

# --- Python Routing Service (Bidirectional A*) ---
# Monolith (1 Railway service: Node + Python cùng container — không tách service):
#   Repo có railway.json ép build dùng Dockerfile GỐC (không dùng python_routing/Dockerfile).
#   Build → Builder = Dockerfile, path = Dockerfile (hoặc để Railway đọc railway.json).
#   Deploy → Start Command = node scripts/railway-start.js (railway.json đã set).
#   Biến: PYTHON_ROUTING_ENABLED=true, PYTHON_ROUTING_URL=http://127.0.0.1:8001, PYTHON_ROUTING_PORT=8001,
#         ROUTING_LEGACY_FALLBACK=false, DATABASE_URL (Python đọc chung với Node).
#   Lưu ý: Railway inject PORT cho Node; PYTHON_ROUTING_PORT bắt buộc (vd 8001) để không trùng cổng.
# BẮT BUỘC trên production nếu chỉ deploy Node: không có Python → Node gọi localhost:8001 → fail →
# fallback A* legacy (tải cả đồ thị từ DB mỗi request) → rất chậm / timeout 15s ở client.
# Railway — service Python (cùng repo backend). Nếu log: ModuleNotFoundError: fastapi
# → build chưa cài requirements.txt (Nixpacks chọn Node vì package.json ở root). Cách ổn định:
#   Settings → Build → Builder = Dockerfile, Dockerfile path = python_routing/Dockerfile
#   (context thường là GỐC repo; Dockerfile COPY python_routing/... — đã chỉnh trong repo.)
# Hoặc không dùng Docker: Root Directory = python_routing + Start python main.py (để Nixpacks thấy requirements.txt).
#
# Không dùng Docker, một trong hai:
#   (1) Source → Root Directory = python_routing  →  Deploy Start: python main.py
#   (2) Root = cả repo  →  Custom Build: cd python_routing && python -m pip install -r requirements.txt
#                         + Start: python python_routing/main.py
# (Watch Path /python_routing/** chỉ kích hoạt deploy, KHÔNG cài pip deps.)
#
# Trên Railway: tạo SERVICE THỨ HAI (Python), cùng DATABASE_URL, rồi set:
#   PYTHON_ROUTING_URL=https://<tên-miền-public-của-service-python>.up.railway.app
# (hoặc biến tham chiếu service trong Railway Variables). Service Node PHẢI trỏ được tới URL đó.
#
# URL mà Node.js sẽ gọi Python service (default localhost:8001 — chỉ đúng khi chạy npm run start:all local)
# PYTHON_ROUTING_URL=http://localhost:8001
# Tắt hoàn toàn Python routing để quay về Node legacy A* (dùng khi chỉ deploy 1 service Node)
# PYTHON_ROUTING_ENABLED=false
# Cầu chì bảo vệ OOM: tắt legacy Node A* nặng (safe-path sẽ trả 503, API khác vẫn sống).
# ROUTING_LEGACY_ENABLED=true
# Timeout (ms) Node → Python cho GET /safe-path (đồ thị lớn có thể vài chục giây). Frontend axios cần >= giá trị này.
# PYTHON_ROUTING_FETCH_TIMEOUT_MS=120000
# Railway hay trả 502 khi Node treo/OOM: fallback A* legacy tải cả DB. Trên prod có Python: nên false.
# ROUTING_LEGACY_FALLBACK=false
# Timeout (ms) cho GET /health (chỉ khi ROUTING_LEGACY_FALLBACK=true). Default 15000 — Railway cold start hay >5s.
# PYTHON_ROUTING_HEALTH_TIMEOUT_MS=15000
# Port Python FastAPI service (default 8001)
# PYTHON_ROUTING_PORT=8001
# Tần suất refresh graph in-memory (giây), mặc định 60. Set 0 để tắt refresh nền (giảm spike RAM do rebuild snapshot).
# GRAPH_REFRESH_INTERVAL_SECONDS=60
# Giảm RAM mạnh: tắt bidirectional graph (không lưu adj_backward); đổi lại A* chậm hơn.
# ROUTING_ENABLE_BIDIRECTIONAL=false
# Python: số node gần nhất mỗi đầu đường (tối đa N² lần A* / request). Đồ thị ~1.5M node: thử 3 nếu FE vẫn timeout.
# ROUTING_SNAP_CANDIDATE_LIMIT=6
# Đường dẫn ML model (Phase 3)
# ML_MODEL_PATH=python_routing/ml/models/flood_depth_model.joblib
