# Sao chép thành file .env và điền giá trị thật (không commit .env)

# MQTT / DB / JWT ... (theo môi trường của bạn)

# --- Resend: gửi OTP email ---
# Tạo key tại https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Phải là địa chỉ thuộc domain đã Verified trên Resend
OTP_FROM_EMAIL=OTP FloodSight <no-reply@floodsight.id.vn>
# ID hoặc alias template OTP đã Publish. HTML mẫu (copy vào Resend): templates/resend-otp.html
RESEND_OTP_TEMPLATE_ID=
# Tuỳ chọn: tên thương hiệu trong mail (mặc định FloodWatch)
# OTP_BRAND_NAME=FloodSight
# Email hỗ trợ hiển thị trong mail (mặc định lấy từ OTP_FROM_EMAIL)
# OTP_SUPPORT_EMAIL=hotline@floodsight.id.vn
# Link "trang chủ" trong mail (mặc định # hoặc PUBLIC_WEB_URL nếu có)
# OTP_HELP_URL=https://floodsight.id.vn

OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
